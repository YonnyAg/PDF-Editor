#include <windows.h>
IDI_APP_ICON ICON "@PDF_EDITOR_ICON@"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PDF_EDITOR_WIN_VERSION@
 PRODUCTVERSION @PDF_EDITOR_WIN_VERSION@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "PDF Editor\0"
   VALUE "FileDescription", "PDF Editor\0"
   VALUE "FileVersion", "@PDF_EDITOR_VERSION@\0"
   VALUE "InternalName", "pdf_editor\0"
   VALUE "LegalCopyright", "Copyright (c) 2026 PDF Editor contributors\0"
   VALUE "OriginalFilename", "pdf_editor.exe\0"
   VALUE "ProductName", "PDF Editor\0"
   VALUE "ProductVersion", "@PDF_EDITOR_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
